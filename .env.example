# Google Gemini Enterprise Agent Platform (formerly Vertex AI)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-lite-image
GOOGLE_IMAGE_ASPECT_RATIO=3:4
GOOGLE_IMAGE_THRESHOLD=200

# Private object storage; create the bucket and grant the runtime identity write access
GCS_ASSET_BUCKET=your-private-production-assets-bucket
GCS_REGION=us-central1
# Local development: run `gcloud auth application-default login` instead of saving a key here.
# GitHub Actions: configure OIDC Workload Identity Federation; do not store a service-account key.
GOOGLE_APPLICATION_CREDENTIALS=

# AI providers; keep real values only in an ignored local .env or secret manager
MIDJOURNEY_API_KEY=
STABILITY_API_KEY=
OPENAI_API_KEY=

# Generation defaults
IMAGE_PROVIDER=google-gemini-agent-platform
IMAGE_OUTPUT_FORMAT=png
IMAGE_OUTPUT_DPI=300